+    but capped at 60s so a misbehaving upstream header can't strand us; that 60s
+    cap is on the *hint only*, not on our own doubling.
     """
     cls = _POLICY.get(category, Pause)
     if cls is Pause:
         return Pause()
     if cls is RetryNow:
         return RetryNow()
-    if prior_backoff_attempts >= _MAX_BACKOFF_ATTEMPTS:
