+    """Symmetry: False propagates False (interactive parent -> interactive child)."""
+    capture: dict = {}
+    ctx = ToolContext(project_root=tmp_path, fs_permissions=(),
+                     events_path=tmp_path / "events.jsonl")
+    ctx.subagent_defs = {"helper": _agent("helper")}
