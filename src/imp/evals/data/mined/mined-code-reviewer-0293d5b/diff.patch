@@ -0,0 +1,32 @@
+"""Walk-up project root discovery."""
+
+from __future__ import annotations
+
+from pathlib import Path
+
+from imp.engine.project_root import find_project_root
+
+
+def test_finds_imp_dir_in_cwd(tmp_path: Path) -> None:
+    (tmp_path / ".imp").mkdir()
+    assert find_project_root(start=tmp_path) == tmp_path
+
+
+def test_walks_up_from_subdir(tmp_path: Path) -> None:
+    (tmp_path / ".imp").mkdir()
+    deep = tmp_path / "a" / "b" / "c"
+    deep.mkdir(parents=True)
+    assert find_project_root(start=deep) == tmp_path
+
+
+def test_returns_cwd_when_no_imp_dir(tmp_path: Path) -> None:
+    # `imp init` is expected to run before any .imp/ exists.
+    assert find_project_root(start=tmp_path) == tmp_path
+
+
+def test_stops_at_filesystem_root(tmp_path: Path) -> None:
+    # Sanity: walk doesn't loop or escape into the user's actual /
+    # Verified by asserting we get back start when no .imp/ found.
+    deep = tmp_path / "x" / "y"
+    deep.mkdir(parents=True)
+    assert find_project_root(start=deep) == deep
