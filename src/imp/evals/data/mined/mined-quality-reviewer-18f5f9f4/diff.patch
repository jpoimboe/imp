diff --git a/src/imp/engine/naming.py b/src/imp/engine/naming.py
new file mode 100644
index 0000000..64b835c
--- /dev/null
+++ b/src/imp/engine/naming.py
@@ -0,0 +1,23 @@
+"""Random three-word phrase for the default Change title (spec §3.1).
+
+This is engine code, so `random` is fair game. The combinatorial space of three
+independent words makes same-instant collisions negligible; create_worktree
+still retries on the rare branch collision.
+"""
+
+from __future__ import annotations
+
+import random
+from importlib.resources import files
+
+
+def _words() -> list[str]:
+    text = files("imp.assets").joinpath("words.txt").read_text()
+    return [w.strip() for w in text.splitlines() if w.strip()]
+
+
+def random_title(rng: random.Random | None = None) -> str:
+    """e.g. "brave silver otter". Slug is derived from this via slug.slugify."""
+    r = rng or random
+    pool = _words()
+    return " ".join(r.choice(pool) for _ in range(3))
diff --git a/tests/test_naming.py b/tests/test_naming.py
new file mode 100644
index 0000000..439f957
--- /dev/null
+++ b/tests/test_naming.py
@@ -0,0 +1,15 @@
+import re
+
+from imp.engine.naming import random_title
+
+
+def test_random_title_three_lowercase_words() -> None:
+    title = random_title()
+    # Shape only — never assert literal RNG output (spec §11 "shape-valid").
+    assert re.fullmatch(r"[a-z]+ [a-z]+ [a-z]+", title), title
+
+
+def test_random_title_varies() -> None:
+    # Over many draws we should see more than one distinct phrase.
+    seen = {random_title() for _ in range(50)}
+    assert len(seen) > 1
