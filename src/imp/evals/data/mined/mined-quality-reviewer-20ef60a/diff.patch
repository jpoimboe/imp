+    if rows:
+        print(_STATUS_HEADER)
+        for r in rows:
+            print(f"{r[0]:<24} {r[1]:<12} {r[2]:<18} {r[3]:<20} {r[4]}")
+    else:
+        print(empty_msg)
+
+
