+def test_run_q1_q4_excludes_self_graded_and_threads_raw_counts(monkeypatch, tmp_path):
+    """run_paired runs once per fixture; the Q1 pool drops a mined spec-task
+    fixture, the Q4 pool drops a mined code fixture, curated stays in both."""
+    from imp.evals import analysis
+    from imp.evals.models import (
+        ExpectedFinding,
+        Fixture,
+        FixtureMeta,
+        GradeResult,
+        ReviewFinding,
+        RunResult,
+        Telemetry,
+    )
+
+    def _fx(fid, source, role):
+        return Fixture(
+            fid, source, "a", "b", "", "",
+            (ExpectedFinding("x.py:1", "s", "d", "Major", True),), (),
+            FixtureMeta(role, None, True, False),
+        )
+
+    fixtures = [
+        _fx("mined-spec", "mined", "spec-task-reviewer"),  # excluded from Q1
+        _fx("mined-code", "mined", "code-reviewer"),        # excluded from Q4
+        _fx("curated-1", "curated", "code-reviewer"),       # in BOTH pools
+    ]
+
+    paired_calls = []
+
+    def _fake_run_paired(control_root, fx, model_map, **kw):
+        paired_calls.append(fx.id)
+        rf = ReviewFinding("s", "x.py:1", "d", "Major", True)
+        return {
+            "spec-task-reviewer": RunResult("p", fx.id, 0, "", (rf,), Telemetry.zero()),
+            "quality-reviewer": RunResult("p", fx.id, 0, "", (), Telemetry.zero()),
+            "code-reviewer": RunResult("p", fx.id, 0, "", (rf,), Telemetry.zero()),
+        }
+
+    def _fake_grade(fx, rr, **kw):
+        ef = fx.expected_findings[0]
+        from imp.evals.models import FindingMatch
+        caught = bool(rr.findings)
+        return GradeResult(
+            rr.variant_id, fx.id, 0,
+            (FindingMatch(ef, "exact" if caught else "none",
+                          rr.findings[0] if caught else None),),
+            (), (),
+        )
+
+    monkeypatch.setattr("imp.evals.paired.run_paired", _fake_run_paired)
+    monkeypatch.setattr("imp.evals.grader.grade", _fake_grade)
+
+    q1, q4 = analysis.run_q1_q4(
+        tmp_path, fixtures,
+        {r: ("fake", "m") for r in
+         ("spec-task-reviewer", "quality-reviewer", "code-reviewer")},
+        judge_provider="fake", judge_model="m",
+    )
+    # run_paired called once per fixture (expensive — never twice)
+    assert sorted(paired_calls) == ["curated-1", "mined-code", "mined-spec"]
+    # Q1 pool excludes the mined spec-task fixture -> 2 diffs
+    assert q1["n_diffs"] == 2
+    # Q4 pool excludes the mined code fixture -> 2 diffs, and raw counts are present
+    assert q4["n_diffs"] == 2
+    assert "fast_total" in q4 and "union_total" in q4
