+def test_q4_insufficient_then_replace_and_surfaces_raw_counts():
+    thin = compute_q4(fast_c=4, fast_t=5, union_c=5, union_t=5, n_diffs=3)
+    assert thin["verdict"] == "insufficient-diffs"
+    # raw numerator/denominator are surfaced (spec: print 4/5 vs 5/5, not just 0.8/1.0)
+    assert thin["fast_caught"] == 4 and thin["fast_total"] == 5
+    assert thin["union_caught"] == 5 and thin["union_total"] == 5
+    assert thin["fastpath_blocking_recall"] == 0.8
+    assert thin["union_blocking_recall"] == 1.0
+
+    enough = compute_q4(fast_c=82, fast_t=100, union_c=84, union_t=100, n_diffs=200)
+    assert enough["verdict"] == "replace"  # 0.82 >= 0.84 - 0.05 margin
