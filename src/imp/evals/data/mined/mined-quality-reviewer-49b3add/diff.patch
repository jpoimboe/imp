+
+def test_task_slice_roundtrips_through_dict():
+    from imp.evals.models import TaskSlice
+    ts = TaskSlice(index=1, diff="--- a\n+++ b\n", task_context="added the second caller")
+    assert TaskSlice.from_dict(ts.to_dict()) == ts
+
+
+def test_expected_finding_cross_task_survives_reload():
+    # The corruption guard (Component 1, Major): a saved cross_task=True must NOT
+    # silently reload as False through the hand-written from_dict.
+    ef = ExpectedFinding(
+        locus="subagents.py:203", symbol="dispatch_task", description="second caller unbounded",
+        severity="Major", must_catch=True, cross_task=True, manifest_task=1,
+    )
+    back = ExpectedFinding.from_dict(ef.to_dict())
+    assert back.cross_task is True
+    assert back.manifest_task == 1
+    assert back == ef
+
+
+def test_expected_finding_defaults_local_when_fields_absent():
+    # An existing on-disk fixture (no cross_task/manifest_task keys) loads as local.
+    back = ExpectedFinding.from_dict({
+        "locus": "x.py:1", "symbol": "f", "description": "d",
+        "severity": "Major", "must_catch": True,
+    })
+    assert back.cross_task is False
+    assert back.manifest_task is None
+
+
+def test_fixture_with_tasks_roundtrips_and_empty_tasks_is_single_diff():
+    from imp.evals.models import TaskSlice
+    fx = Fixture(
+        id="mt", source="curated", base_sha="a", head_sha="b",
+        diff="CUMULATIVE", task_context="whole change",
+        expected_findings=(ExpectedFinding("x.py:1", "f", "d", "Major", True),),
+        clean_loci=(),
+        meta=FixtureMeta("code-reviewer", None, True, False),
+        tasks=(TaskSlice(0, "D0", "c0"), TaskSlice(1, "D1", "c1")),
+    )
+    assert Fixture.from_dict(fx.to_dict()) == fx
+    # an existing single-diff fixture deserializes with tasks=()
+    legacy = Fixture.from_dict({
+        "id": "legacy", "source": "curated", "base_sha": "a", "head_sha": "b",
+        "diff": "D", "task_context": "c", "expected_findings": [],
+        "clean_loci": [], "meta": {},
+    })
+    assert legacy.tasks == ()
