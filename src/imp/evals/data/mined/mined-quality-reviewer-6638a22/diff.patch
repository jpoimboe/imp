+def test_blank_lines_bracket_the_prompt(tmp_path: Path, capsys) -> None:  # type: ignore[no-untyped-def]
+    from imp.cli.slash import ask_line_with_slash
+    prompt = _FakePrompt(["hello"])
+    line = anyio.run(ask_line_with_slash, prompt, _NullStatus(), _FakeChange(tmp_path))
+    assert line == "hello"
+    out = capsys.readouterr().out
+    # one blank line before the prompt, one after the submitted line
+    assert out.count("\n") >= 2
