diff --git a/src/imp/engine/types.py b/src/imp/engine/types.py
index f4df734..efdc8b2 100644
--- a/src/imp/engine/types.py
+++ b/src/imp/engine/types.py
@@ -138,6 +138,18 @@ class FsRule:
     source: SourceLoc
 
 
+# ── Cross-role model constraints (model_rules:) ───────────────────────────────
+
+@dataclass(frozen=True, slots=True)
+class RoleConstraint:
+    """One role's cross-role model constraint. `differ_provider_from` names
+    another role whose resolved *provider* this role should differ from (a soft
+    preference; see providers/resolve.resolve_roles). `None` means no constraint.
+    """
+    differ_provider_from: str | None = None
+    source: SourceLoc | None = None
+
+
 # ── Agent definition (parsed from .md) ────────────────────────────────────────
 
 @dataclass(frozen=True, slots=True)
@@ -151,6 +163,11 @@ class AgentDef:
     source_path: Path
     source: SourceLoc
     max_tool_calls: int | None = None
+    # The role this agent wants WHEN RUN AS A SUBAGENT (and a default a
+    # top-level step may override via its own model_role:). MUST default to None
+    # — not the string "default" that Step.model_role uses — so dispatch_task
+    # can tell "inherit parent" (None) from "use the 'default' role".
+    model_role: str | None = None
 
 
 # ── Steps & phases ────────────────────────────────────────────────────────────
@@ -212,6 +229,7 @@ class Workflow:
     agents: dict[str, AgentDef] = field(hash=False)
     workflow_dir: Path
     source: SourceLoc
+    model_rules: dict[str, RoleConstraint] = field(hash=False, default_factory=dict)
 
     def flat_steps(self) -> tuple[Step, ...]:
         return tuple(s for p in self.phases for s in p.steps)
diff --git a/tests/test_types.py b/tests/test_types.py
index 023264c..834a505 100644
--- a/tests/test_types.py
+++ b/tests/test_types.py
@@ -97,3 +97,40 @@ def test_workflow_flat_steps_and_goto_resolution() -> None:
 def test_workflow_defaults_max_loops_default() -> None:
     d = WorkflowDefaults(max_retries=3, on_max_retries=Pause())
     assert d.max_loops == 10
+
+
+def test_role_constraint_defaults_and_fields():
+    from imp.engine.types import RoleConstraint
+    c = RoleConstraint(differ_provider_from="code")
+    assert c.differ_provider_from == "code"
+    assert c.source is None
+    assert RoleConstraint().differ_provider_from is None
+
+
+def test_agentdef_model_role_defaults_to_none():
+    from pathlib import Path
+
+    from imp.engine.types import AgentDef, OutputField, OutputSchema, SourceLoc
+    a = AgentDef(
+        name="x", description="", tools=frozenset(), subagents=(),
+        output_schema=OutputSchema(
+            fields=(OutputField(name="status", type="enum",
+                                values=("Success", "Error")),),
+            source=SourceLoc(file=Path("a.md"), line=1)),
+        prompt_template_source="", source_path=Path("a.md"),
+        source=SourceLoc(file=Path("a.md"), line=1))
+    assert a.model_role is None  # CRITICAL: None, not "default"
+
+
+def test_workflow_model_rules_defaults_to_empty():
+    from pathlib import Path
+
+    from imp.engine.types import (
+        SourceLoc, Vars, Workflow, WorkflowDefaults,
+    )
+    from imp.engine.types import Pause
+    wf = Workflow(
+        name="w", description="", phases=(), vars=Vars(decls=()),
+        defaults=WorkflowDefaults(max_retries=0, on_max_retries=Pause()),
+        agents={}, workflow_dir=Path("."), source=SourceLoc(file=Path("w"), line=1))
+    assert wf.model_rules == {}
