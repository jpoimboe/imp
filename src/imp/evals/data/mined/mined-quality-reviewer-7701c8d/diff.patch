@@ -71,6 +71,18 @@ class RunResult(Enum):
     ERRORED = "errored"
 
 
+def _seed_messages(change: Change, wrapper_text: str | None) -> tuple[Message, ...]:
+    """Fresh-entry seed. `<imp:begin/>` (or the wrapper text on a fresh goto),
+    plus a name block when the Change is named — so a named Change conveys its
+    slug through the immutable conversation record, never the cached prefix.
+    Unnamed Changes get the begin token alone (no leaked provisional name)."""
+    opening = wrapper_text or "<imp:begin/>"
+    blocks: list[TextBlock] = [TextBlock(text=opening)]
+    if change.slug:
+        blocks.append(TextBlock(text=f"This Change is named `{change.slug}`."))
+    return (Message(role="user", content=tuple(blocks)),)
+
+
