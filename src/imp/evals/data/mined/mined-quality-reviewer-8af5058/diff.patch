+def test_count_blocking_diffs_per_question_exclusion():
+    from imp.evals.mining import count_blocking_diffs, mark_rework
+
+    # three episodes, two distinct heads. _ep encodes HEAD_SHA: <tid>aaaa.
+    spec = _ep("aaaa", "#### Critical\n- bug\nVerdict: task_gap",
+               "2026-05-28T10:00:00Z", reviewer="spec-task-reviewer")
+    code = _ep("bbbb", "#### Major\n- bug\nVerdict: task_gap",
+               "2026-05-28T11:00:00Z", reviewer="code-reviewer")
+    quality = _ep("bbbb", "#### Major\n- bug\nVerdict: task_gap",
+                  "2026-05-28T12:00:00Z", reviewer="quality-reviewer")
+    flagged = mark_rework([spec, code, quality])
+    c = count_blocking_diffs(flagged)
+
+    # aggregate: distinct blocking heads = {aaaaaaaa, bbbbaaaa} = 2
+    assert c.aggregate_blocking_diffs == 2
+    # Q1 drops spec-task-reviewer episodes -> only head bbbb survives (code+quality) = 1
+    assert c.q1_blocking_diffs == 1
+    # Q4 drops code-reviewer episodes -> head aaaa (spec) + head bbbb (quality) = 2
+    assert c.q4_blocking_diffs == 2
+    # the eyeballed floors (10 aggregate, 8 per-question) are all unmet on this toy set
+    assert c.aggregate_ok is False and c.q1_ok is False and c.q4_ok is False
