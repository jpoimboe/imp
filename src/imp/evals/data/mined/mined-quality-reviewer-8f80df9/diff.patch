diff --git a/src/imp/engine/agent_run.py b/src/imp/engine/agent_run.py
index 935f551..ac97f33 100644
--- a/src/imp/engine/agent_run.py
+++ b/src/imp/engine/agent_run.py
@@ -20,9 +20,15 @@ import it.
 
 from __future__ import annotations
 
+from collections.abc import Awaitable, Callable
 from dataclasses import dataclass
+from pathlib import Path
 from typing import Any
 
+from imp.agents.runner import AgentInvocation, ChangeContext, Message
+from imp.engine.completion import build_continuation_fn, completion_instruction
+from imp.engine.types import AgentDef
+
 
 @dataclass(frozen=True)
 class ErrorInfo:
@@ -53,3 +59,76 @@ class SubagentSuspended(Exception):
     run-loop (transcript left ending at the dangling `task` tool_use) ->
     parent drive_invocation -> executor, which persists status="paused".
     Resume re-enters the step fresh and re-dispatches the subagent subtree."""
+
+
+def build_agent_invocation(
+    *,
+    agent_def: AgentDef,
+    provider_name: str,
+    model_name: str,
+    rendered_system_prompt: str,
+    initial_messages: tuple[Message, ...],
+    change_context: ChangeContext,
+    interactive: bool,
+    user_chat_input_fn: Callable[[str], str | Awaitable[str]] | None,
+    transcript_dir: Path,
+    fs_permissions: Any,
+    events_path: Path,
+    subagent_defs: dict[str, AgentDef],
+    model_tiers: tuple[str, ...],
+    max_tool_calls: int | None,
+    agent_id: str,
+    event_log: Any,
+    change_state: Any,
+    first_event_parent_id: str | None,
+    resolved_roles: dict[str, Any] | None,
+    coordinator: Any,
+    subagent_depth: int = 0,
+    retry_feedback: str | None = None,
+    balance_on_resume: bool = False,
+    log: Any = None,
+) -> AgentInvocation:
+    """Construct one AgentInvocation, owning the completion-contract invariant
+    that drifted between the two creation paths: append
+    `completion_instruction(schema)` to the system prompt AND build the
+    continuation_fn (interactive wrap vs. nudge) from that SAME instruction.
+
+    The caller renders the prompt with its own PromptContext and resolves its
+    own (provider, model) — the builder never branches on agent kind. `model`
+    is a value, not a policy, here.
+    """
+    instruction = completion_instruction(agent_def.output_schema)
+    system_prompt = f"{rendered_system_prompt}\n\n{instruction}"
+    continuation_fn = build_continuation_fn(
+        interactive=interactive,
+        user_chat_input_fn=user_chat_input_fn,
+        instruction=instruction,
+        log=log,
+        agent_id=agent_id,
+    )
+    return AgentInvocation(
+        agent_def=agent_def,
+        provider_name=provider_name,
+        model_name=model_name,
+        system_prompt=system_prompt,
+        initial_messages=initial_messages,
+        change_context=change_context,
+        interactive=interactive,
+        transcript_dir=transcript_dir,
+        fs_permissions=fs_permissions,
+        events_path=events_path,
+        subagent_defs=subagent_defs,
+        max_tool_calls=max_tool_calls,
+        user_input_fn=user_chat_input_fn if interactive else None,
+        continuation_fn=continuation_fn,
+        agent_id=agent_id,
+        event_log=event_log,
+        change_state=change_state,
+        first_event_parent_id=first_event_parent_id,
+        retry_feedback=retry_feedback,
+        balance_on_resume=balance_on_resume,
+        resolved_roles=resolved_roles,
+        model_tiers=model_tiers,
+        subagent_depth=subagent_depth,
+        coordinator=coordinator,
+    )
diff --git a/tests/test_agent_run.py b/tests/test_agent_run.py
index b61e30a..83495e3 100644
--- a/tests/test_agent_run.py
+++ b/tests/test_agent_run.py
@@ -1,5 +1,28 @@
 from __future__ import annotations
 
+from pathlib import Path
+
+from imp.agents.runner import ChangeContext
+from imp.engine.types import AgentDef, OutputField, OutputSchema, SourceLoc
+
+
+def _agent(name: str = "rev", max_tool_calls=None, subagents=()) -> AgentDef:
+    return AgentDef(
+        name=name, description="", tools=frozenset({"complete_step"}),
+        subagents=tuple(subagents),
+        output_schema=OutputSchema(
+            fields=(OutputField(name="status", type="enum",
+                                values=("Success", "Error"), required=True),),
+            source=SourceLoc(file=Path("a.md"), line=1)),
+        prompt_template_source="body", source_path=Path("a.md"),
+        source=SourceLoc(file=Path("a.md"), line=1),
+        max_tool_calls=max_tool_calls)
+
+
+def _cc(tmp: Path) -> ChangeContext:
+    return ChangeContext(slug="s", title="t", project_root=tmp,
+                         workflow_dir=tmp / "wf")
+
 
 def test_error_info_and_agent_run_result_live_in_agent_run() -> None:
     from imp.engine.agent_run import AgentRunResult, ErrorInfo, SubagentSuspended
@@ -25,3 +48,50 @@ def test_executor_reexports_agent_run_result() -> None:
     # from executor (verified by grep), so there is no re-export to preserve.
     from imp.engine.executor import AgentRunResult
     assert AgentRunResult.__module__ == "imp.engine.agent_run"
+
+
+def test_build_agent_invocation_appends_completion_instruction(tmp_path: Path) -> None:
+    from imp.engine.agent_run import build_agent_invocation
+
+    inv = build_agent_invocation(
+        agent_def=_agent(), provider_name="anthropic", model_name="m",
+        rendered_system_prompt="RENDERED BODY",
+        initial_messages=(), change_context=_cc(tmp_path),
+        interactive=False, user_chat_input_fn=None,
+        transcript_dir=tmp_path / "td", fs_permissions=(),
+        events_path=tmp_path / "e.jsonl", subagent_defs={}, model_tiers=(),
+        max_tool_calls=7, agent_id="sub:abc", event_log=None,
+        change_state=None, first_event_parent_id="tc-1",
+        resolved_roles=None, coordinator=None, subagent_depth=2)
+
+    # System prompt = rendered body + the complete_step contract.
+    assert inv.system_prompt.startswith("RENDERED BODY")
+    assert "complete_step" in inv.system_prompt
+    # Non-interactive -> a nudge continuation is wired (omission #1/#2 closed).
+    assert inv.continuation_fn is not None
+    # Ceiling resolved (omission #3 closed).
+    assert inv.max_tool_calls == 7
+    # Threaded fields land on the invocation.
+    assert inv.subagent_depth == 2
+    assert inv.agent_id == "sub:abc"
+    assert inv.first_event_parent_id == "tc-1"
+    assert inv.user_input_fn is None  # non-interactive
+
+
+def test_build_agent_invocation_interactive_wires_user_input(tmp_path: Path) -> None:
+    from imp.engine.agent_run import build_agent_invocation
+
+    inv = build_agent_invocation(
+        agent_def=_agent(), provider_name="anthropic", model_name="m",
+        rendered_system_prompt="BODY", initial_messages=(),
+        change_context=_cc(tmp_path), interactive=True,
+        user_chat_input_fn=lambda _p: "hi",
+        transcript_dir=tmp_path / "td", fs_permissions=(),
+        events_path=tmp_path / "e.jsonl", subagent_defs={}, model_tiers=(),
+        max_tool_calls=None, agent_id="step:p/s", event_log=None,
+        change_state=None, first_event_parent_id=None,
+        resolved_roles=None, coordinator=None)
+
+    assert inv.interactive is True
+    assert inv.continuation_fn is not None
+    assert inv.user_input_fn is not None  # interactive -> PROMPT_USER resume wired
