diff --git a/src/imp/cli/signals.py b/src/imp/cli/signals.py
index 2f36724..defc159 100644
--- a/src/imp/cli/signals.py
+++ b/src/imp/cli/signals.py
@@ -14,9 +14,16 @@ installed when imp starts.
 
 from __future__ import annotations
 
+import contextlib
+import os
+import signal
+import time
+
 from imp.engine.change import Change
 from imp.engine.state import State
 
+_suppress = contextlib.suppress
+
 # Mid-stream ESC (cancel an LLM call in flight) is post-V0. The langchain
 # cancellation token API in the installed version doesn't surface cleanly
 # through deepagents' stream interface; punt to Plan 4. V0 ESC only fires
@@ -33,3 +40,67 @@ def pause_and_exit(change: Change, *, reason: str) -> None:
         # State never reached the durable phase — nothing to update
         pass
     change.event_log().append("workflow_paused", {"reason": reason})
+
+
+def install_process_group() -> None:
+    """Become process-group leader so child subprocesses can be killed en
+    masse on Ctrl+C. POSIX-only; no-op on Windows."""
+    try:
+        os.setpgrp()
+    except (AttributeError, OSError):
+        # Windows or already a leader; non-fatal
+        pass
+
+
+def tool_kill_escalation(
+    *, timeout: float = 2.0, kill_self: bool = True,
+) -> None:
+    """Send SIGTERM to our PG, wait `timeout`, then SIGKILL anything alive.
+
+    If kill_self is False, send to every member of the PG EXCEPT us — used
+    by tests so pytest itself doesn't die. The CLI always calls with the
+    default (kill_self=True) — by then we've already saved state and are
+    about to sys.exit.
+    """
+    if not hasattr(os, "killpg"):
+        return  # Windows or other non-POSIX
+    pgid = os.getpgrp()
+    if kill_self:
+        with _suppress(ProcessLookupError):
+            os.killpg(pgid, signal.SIGTERM)
+    else:
+        _signal_pg_excluding_self(pgid, signal.SIGTERM)
+    time.sleep(timeout)
+    if kill_self:
+        with _suppress(ProcessLookupError):
+            os.killpg(pgid, signal.SIGKILL)
+    else:
+        _signal_pg_excluding_self(pgid, signal.SIGKILL)
+
+
+def _signal_pg_excluding_self(pgid: int, sig: int) -> None:
+    """Walk /proc looking for procs whose PGID matches; signal those that
+    aren't us. POSIX-only; best-effort."""
+    self_pid = os.getpid()
+    try:
+        entries = os.listdir("/proc")
+    except FileNotFoundError:  # non-Linux POSIX (macOS) — skip in this path
+        return
+    for entry in entries:
+        if not entry.isdigit():
+            continue
+        pid = int(entry)
+        if pid == self_pid:
+            continue
+        try:
+            with open(f"/proc/{pid}/stat") as f:
+                # Field 5 is pgid; format: pid (comm) state ppid pgid ...
+                # comm may contain spaces, so parse from the closing paren
+                stat = f.read()
+            close_paren = stat.rfind(")")
+            fields = stat[close_paren + 2:].split()
+            if int(fields[2]) == pgid:
+                with _suppress(ProcessLookupError, PermissionError):
+                    os.kill(pid, sig)
+        except (FileNotFoundError, OSError, IndexError, ValueError):
+            continue
diff --git a/tests/test_signals.py b/tests/test_signals.py
index 3f7a8f8..1fcd17a 100644
--- a/tests/test_signals.py
+++ b/tests/test_signals.py
@@ -76,3 +76,50 @@ def test_pause_when_no_state_file(tmp_path: Path) -> None:
         e["type"] == "workflow_paused" and e["payload"].get("reason") == "early"
         for e in events
     )
+
+
+import os
+import signal
+import subprocess
+import sys
+import time
+import contextlib
+
+import pytest
+
+
+@pytest.mark.skipif(sys.platform == "win32", reason="POSIX only")
+def test_install_process_group_makes_us_leader() -> None:
+    """After install_process_group, our PID == our PGID."""
+    from imp.cli.signals import install_process_group
+
+    install_process_group()
+    assert os.getpid() == os.getpgid(0)
+
+
+@pytest.mark.skipif(sys.platform == "win32", reason="POSIX only")
+@pytest.mark.skipif(sys.platform == "darwin", reason="POSIX /proc-walk not available on macOS")
+def test_tool_kill_escalation_terminates_child(tmp_path: Path) -> None:
+    """Spawn a child in our PG, call escalation, child must be dead."""
+    from imp.cli.signals import install_process_group, tool_kill_escalation
+
+    install_process_group()
+    # Child sleeps; we expect it to be killed
+    child = subprocess.Popen(
+        [sys.executable, "-c", "import time; time.sleep(30)"],
+    )
+    # Brief settle so /proc/<child_pid>/stat is available
+    time.sleep(0.1)
+    try:
+        # Send SIGTERM-then-SIGKILL to the PG (which includes us — pytest
+        # would die — so we exclude self by passing kill_self=False)
+        tool_kill_escalation(timeout=0.5, kill_self=False)
+        # Child should be gone in well under our 5s test budget
+        for _ in range(50):
+            if child.poll() is not None:
+                break
+            time.sleep(0.1)
+        assert child.poll() is not None, "child wasn't killed"
+    finally:
+        with contextlib.suppress(ProcessLookupError):
+            child.kill()
