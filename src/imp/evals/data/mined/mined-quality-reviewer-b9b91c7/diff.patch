+        {"type": "web_fetch_tool_result", "tool_use_id": "f1",
+         "content": {"type": "web_fetch_result", "url": "https://doc.test",
+                     "content": {"type": "text", "text": "body text"}}},
+    ]}
+    elog = InMemoryEventLog()
