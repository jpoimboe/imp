+# author self-review and the reviewer pass.
+FALSIFIABILITY_MARKERS = [
+    (AGENTS_DIR / "code-reviewer.md", "falsifiab"),  # C: whole-change backstop
+]
+
+
+@pytest.mark.parametrize(
