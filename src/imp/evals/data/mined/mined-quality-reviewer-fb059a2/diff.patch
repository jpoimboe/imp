diff --git a/src/imp/cli/render_text.py b/src/imp/cli/render_text.py
index 50338f5..3d60ec6 100644
--- a/src/imp/cli/render_text.py
+++ b/src/imp/cli/render_text.py
@@ -17,6 +17,8 @@ from imp.cli import palette as pal
 
 _INDENT = "  "          # two spaces per tree level
 
+_DIFFER_LABELS = {1: "vendor jump", 2: "same-vendor fallback", 3: "identical"}
+
 
 def render_tree(tree: nv.NarrativeTree, *, full: bool, color: bool,
                 width: int = 80) -> Iterator[str]:
@@ -144,6 +146,18 @@ def _render(node: Any, *, depth: int, full: bool, color: bool,
             yield _line(f"error: {tag}{node.message}", depth, color, *pal.NODE_COLORS["error"])
         return
 
+    if isinstance(node, nv.RolesResolvedNode):
+        yield _line("roles resolved:", depth, color)
+        width = max((len(r["role"]) for r in node.rows), default=0)
+        for r in node.rows:
+            line = f"  {r['role']:<{width}} → {r['provider']}/{r['model']}"
+            if r["differ_tier"] is not None:
+                label = _DIFFER_LABELS.get(r["differ_tier"], "?")
+                line += (f"   (differ from {r['differ_from']}: "
+                         f"tier {r['differ_tier']}, {label})")
+            yield _line(line, depth, color)
+        return
+
     if isinstance(node, nv.FallbackLine):
         kv = " ".join(f"{k}={v}" for k, v in node.payload.items())
         yield _line(f"{node.event_type}  {kv}".rstrip(), depth, color, "dim")
diff --git a/tests/test_render_text.py b/tests/test_render_text.py
index 625fb77..e0637b9 100644
--- a/tests/test_render_text.py
+++ b/tests/test_render_text.py
@@ -278,6 +278,35 @@ def test_roles_resolved_attaches_at_root() -> None:
          "differ_tier": None, "differ_from": None}]
 
 
+def test_roles_resolved_renders_constrained_and_unconstrained() -> None:
+    node = nv.RolesResolvedNode(rows=[
+        {"role": "code", "provider": "anthropic", "model": "haiku",
+         "differ_tier": None, "differ_from": None},
+        {"role": "code_review", "provider": "openai", "model": "gpt-5.2",
+         "differ_tier": 1, "differ_from": "code"},
+        {"role": "spec", "provider": "anthropic", "model": "opus",
+         "differ_tier": 2, "differ_from": "code"},
+    ])
+    out = list(rt._render(node, depth=0, full=False, color=False, width=120))
+
+    assert out[0] == "roles resolved:"
+
+    # unconstrained: provider/model only, no differ annotation
+    code_line = next(ln for ln in out if ln.lstrip().startswith("code "))
+    assert "→ anthropic/haiku" in code_line
+    assert "differ from" not in code_line
+
+    # tier-1 constrained: vendor jump
+    cr_line = next(ln for ln in out if "code_review" in ln)
+    assert "→ openai/gpt-5.2" in cr_line
+    assert "(differ from code: tier 1, vendor jump)" in cr_line
+
+    # tier-2 constrained: same-vendor fallback
+    spec_line = next(ln for ln in out if ln.lstrip().startswith("spec"))
+    assert "→ anthropic/opus" in spec_line
+    assert "(differ from code: tier 2, same-vendor fallback)" in spec_line
+
+
 def test_breadcrumb_line_renders_check_step_and_seconds() -> None:
     from imp.cli import narrative as nv
     from imp.cli import render_text as rt
